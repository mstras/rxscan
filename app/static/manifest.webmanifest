{
  "id": "/",
  "name": "RxScan",
  "short_name": "RxScan",
  "description": "Photograph prescription receipts and append them to a Google Sheet.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f5f2",
  "theme_color": "#0f766e",
  "categories": ["medical", "productivity", "finance"],
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Scan a receipt",
      "short_name": "Scan",
      "url": "/?action=camera",
      "icons": [{ "src": "/static/icons/shortcut-camera.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "images", "accept": ["image/*", ".heic", ".heif", ".jpg", ".jpeg", ".png", ".webp"] }]
    }
  }
}
