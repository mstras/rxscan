# Everything in the "Vision model" and "Sheet defaults" blocks can also be set
# from the app's Settings panel (gear icon). Values saved there override these.

# --- Vision model ---------------------------------------------------------
# gemini (default), anthropic, or ollama
VISION_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OLLAMA_URL=http://192.168.50.229:11434
OLLAMA_MODEL=qwen2.5vl:7b

# --- Google Sheets connection ---------------------------------------------
# Easiest: leave these blank and use Settings → Google Sheets in the app.
# auto | apps_script | service_account
SHEETS_BACKEND=auto
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# --- Receipt copies ---------------------------------------------------------
# auto (Drive via Apps Script if connected, else this server) | drive | local | off
RECEIPT_STORAGE=auto
# Drive: pick the folder in Settings (or set its ID here). Without one, a "RxScan Receipts"
# folder in My Drive is used.
RECEIPTS_FOLDER_ID=
RECEIPTS_FOLDER=RxScan Receipts
# Put photos in a subfolder per year (Drive: <folder>/2026, server: <dir>/2026/11)
RECEIPTS_YEAR_FOLDERS=true
# Server copies: path inside the container. Mount a host folder in docker-compose.yml to use it.
RECEIPTS_LOCAL_DIR=/data/receipts
# Base URL used in links to copies saved on this server (detected automatically if blank)
PUBLIC_URL=

# --- Sheet defaults -------------------------------------------------------
DEFAULT_SHEET_URL=
DEFAULT_SHEET_TAB=
# If a tab already has headers, add RxScan's missing columns to the end of row 1
ADD_MISSING_COLUMNS=false
MAX_IMAGE_EDGE=2000

# --- App (env only) -------------------------------------------------------
# Only for the service-account connection (also uncomment the volume in docker-compose.yml)
GOOGLE_CREDENTIALS_FILE=/config/service-account.json
# Sign-in. Built-in login is admin / admin123. Set these only to override it.
# Changing either value signs everyone out.
APP_USERNAME=
APP_PASSWORD=
# How long a sign-in lasts (days)
SESSION_DAYS=90
TZ=America/New_York
# Set true to test the UI with fake parse results (no API key needed)
MOCK_PARSER=false
